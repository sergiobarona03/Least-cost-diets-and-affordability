# =========================================================
# FOOD SUPPLY FLOW MAP — single-panel version
#
# Replaces the three side-by-side maps with ONE map in which flows are
# coloured by destination city. Reason: Springer caps figures at 174 mm
# wide, which leaves ~58 mm per panel in a three-panel layout; at that
# size the origin circles fall below 1 mm and the flow lines disappear.
# A single map gives the whole 174 mm to one rendering of Colombia.
#
# The three supply systems are largely separated in space (Antioquia,
# the centre/north-east, and the south-west), so overlap is limited.
#
# Also adds labels for the departments the Study area section names, so
# that a reader unfamiliar with Colombian geography can connect the text
# to the map.
#
# Reads:  shapefiles + distancia_cantidad.xlsx (as in the original)
# Writes: food_supply_flows.png / .pdf
# =========================================================
suppressPackageStartupMessages({
library(sf)
library(dplyr)
library(ggplot2)
library(readxl)
library(stringr)
library(purrr)
library(ggspatial)
library(ggrepel)
library(grid)
library(scales)
})
# =========================================================
# 1. PATHS
# =========================================================
base_dir <- "C:/Users/sergio.barona/Desktop/Least-cost-diets-and-affordability/Proyecto Interno/mapa/shp.files"
path_col   <- file.path(base_dir, "colombia", "COLOMBIA.shp")
path_muni  <- file.path(base_dir, "DANE_geodata", "MGN_ANM_MPIOS_WGS84.shp")
path_world <- file.path(base_dir, "world", "world.shp")
path_dist  <- "C:/Users/sergio.barona/Desktop/Least-cost-diets-and-affordability/Proyecto Interno/mapa/distancia_cantidad.xlsx"
out_dir  <- "C:/Users/sergio.barona/Desktop/Least-cost-diets-and-affordability/Proyecto Interno/mapa"
out_png  <- file.path(out_dir, "food_supply_flows.png")
out_pdf  <- file.path(out_dir, "food_supply_flows.pdf")
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
# =========================================================
# 2. READ DATA
# =========================================================
colombia <- st_read(path_col, quiet = TRUE)
muni     <- st_read(path_muni, quiet = TRUE)
world    <- st_read(path_world, quiet = TRUE)
dist_raw <- read_excel(path_dist)
# =========================================================
# 3. CRS
# =========================================================
if (is.na(st_crs(colombia))) st_crs(colombia) <- 4326
if (is.na(st_crs(muni)))     st_crs(muni)     <- 4326
if (is.na(st_crs(world)))    st_crs(world)    <- 4326
colombia <- st_transform(colombia, 4326)
muni     <- st_transform(muni, 4326)
world    <- st_transform(world, 4326)
# =========================================================
# 4. HELPERS
# =========================================================
std_code <- function(x) {
x <- as.character(x)
x <- stringr::str_trim(x)
x <- stringr::str_remove(x, "\\.0$")
stringr::str_pad(x, width = 5, side = "left", pad = "0")
}
pick_col <- function(df, candidates) {
hit <- candidates[candidates %in% names(df)]
if (length(hit) > 0) hit[1] else NA_character_
}
make_lines_sf <- function(df) {
geoms <- purrr::map(seq_len(nrow(df)), function(i) {
st_linestring(matrix(c(df$x_from[i], df$x_to[i],
df$y_from[i], df$y_to[i]),
ncol = 2, byrow = FALSE))
})
st_sf(df, geometry = st_sfc(geoms, crs = 4326))
}
round_to_base <- function(x, base = 10000) round(x / base) * base
# =========================================================
# 5. CLEAN DATA
# =========================================================
muni <- muni %>% mutate(MPIO_CDPMP = std_code(MPIO_CDPMP))
dist <- dist_raw %>%
mutate(from = std_code(from),
to   = std_code(to),
quantity = suppressWarnings(as.numeric(quantity)))
latin_america <- world %>% filter(region_wb == "Latin America & Caribbean")
# =========================================================
# 6. MUNICIPAL CENTROIDS
# =========================================================
name_col <- pick_col(muni, c("MPIO_CNMBR", "NOM_MPIO", "NOMBRE_MPIO",
"MPIO_NOMBRE", "MUNICIPIO", "NOMB_MPIO",
"NOMMUNICI", "NAME_2"))
muni_centroids <- muni %>% st_make_valid() %>% st_point_on_surface()
coords <- st_coordinates(muni_centroids)
mun_xy <- muni_centroids %>%
st_drop_geometry() %>%
transmute(
mun_code = MPIO_CDPMP,
mun_name = if (!is.na(name_col)) as.character(.data[[name_col]]) else MPIO_CDPMP,
x = coords[, 1],
y = coords[, 2]) %>%
filter(is.finite(x), is.finite(y), !is.na(mun_code))
# =========================================================
# 7. MAIN CITIES
# =========================================================
cities_keep <- c("05001", "11001", "76001")
city_labels <- c("05001" = "Medellín",
"11001" = "Bogotá",
"76001" = "Cali")
CITY_ORDER <- c("Bogotá", "Medellín", "Cali")
# One hue per destination city. Chosen to stay distinguishable in
# greyscale: the printed version differs in lightness, not only in hue.
CITY_COLS <- c("Bogotá"   = "#1B4F72",
"Medellín" = "#B9770E",
"Cali"     = "#7D3C98")
# =========================================================
# 8. AGGREGATE FLOWS
# =========================================================
flow1 <- dist %>%
filter(to %in% cities_keep, from != to,
is.finite(quantity), quantity > 0) %>%
group_by(to, from) %>%
summarise(qty_total = sum(quantity, na.rm = TRUE), .groups = "drop") %>%
left_join(mun_xy %>% rename(from = mun_code, mun_name_from = mun_name,
x_from = x, y_from = y), by = "from") %>%
left_join(mun_xy %>% rename(to = mun_code, mun_name_to = mun_name,
x_to = x, y_to = y), by = "to") %>%
mutate(city = recode(to, !!!city_labels)) %>%
filter(is.finite(x_from), is.finite(y_from),
is.finite(x_to), is.finite(y_to), !is.na(city)) %>%
mutate(city = factor(city, levels = CITY_ORDER))
if (nrow(flow1) == 0) stop("No hay flujos válidos tras unir con centroides.")
# =========================================================
# 9. TOP ORIGINS
# =========================================================
top_n <- 35
flow_top <- flow1 %>%
group_by(city) %>%
slice_max(order_by = qty_total, n = top_n, with_ties = FALSE) %>%
ungroup()
# =========================================================
# 10. SUPPLY LEVELS
# =========================================================
round_to <- 10000
low_max <- round_to_base(quantile(flow_top$qty_total, 1/3, na.rm = TRUE), round_to)
med_max <- round_to_base(quantile(flow_top$qty_total, 2/3, na.rm = TRUE), round_to)
if (med_max <= low_max) med_max <- low_max + round_to
flow_top <- flow_top %>%
mutate(supply_level = case_when(
qty_total <  low_max ~ "Low",
qty_total <  med_max ~ "Medium",
TRUE                 ~ "High"),
supply_level = factor(supply_level,
levels = c("Low", "Medium", "High")))
message(sprintf("  supply cut-offs: Low < %s | Medium < %s | High >= %s tonnes",
comma(low_max), comma(med_max), comma(med_max)))
# =========================================================
# 11. SF OBJECTS
# =========================================================
lines_top <- make_lines_sf(flow_top)
orig_pts <- flow_top %>%
distinct(city, from, mun_name_from, qty_total, supply_level, x_from, y_from) %>%
st_as_sf(coords = c("x_from", "y_from"), crs = 4326)
dest_pts <- flow_top %>%
distinct(city, to, mun_name_to, x_to, y_to) %>%
st_as_sf(coords = c("x_to", "y_to"), crs = 4326)
# =========================================================
# 12. DEPARTMENT LABELS
#     The Study area section names Cauca, Nariño, Huila and Tolima as
#     Cali's suppliers; Antioquia and Cundinamarca anchor the other two.
#     Labels are placed at the polygon's point on surface.
# =========================================================
dept_col <- pick_col(colombia, c("DPTO_CNMBR", "NOMBRE_DPT", "NOM_DEPART",
"DEPARTAMEN", "NAME_1", "DPTO"))
message("  department name column: ", dept_col)
if (is.na(dept_col)) {
message("  columns available in COLOMBIA.shp: ",
paste(names(st_drop_geometry(colombia)), collapse = ", "))
}
DEPTS_LABEL <- c("ANTIOQUIA", "CUNDINAMARCA", "BOYACÁ", "TOLIMA",
"HUILA", "CAUCA", "NARIÑO", "VALLE DEL CAUCA",
"SANTANDER", "META")
dept_labels <- NULL
if (!is.na(dept_col)) {
dl <- colombia %>%
mutate(dept_up = toupper(iconv(.data[[dept_col]], to = "UTF-8"))) %>%
filter(dept_up %in% DEPTS_LABEL) %>%
st_make_valid() %>%
st_point_on_surface()
if (nrow(dl) > 0) {
dlc <- st_coordinates(dl)
dept_labels <- dl %>%
st_drop_geometry() %>%
transmute(label = stringr::str_to_title(dept_up),
x = dlc[, 1], y = dlc[, 2])
}
}
# =========================================================
# 13. EXTENT
#     Trimmed to the Andean band where every flow sits. The Amazon and
#     Orinoco regions hold no origins and were taking up more than half
#     of each panel in the three-panel version.
# =========================================================
xlim_col <- c(-79.2, -70.0)
ylim_col <- c(-1.0, 12.8)
# =========================================================
# 14. THEME
# =========================================================
theme_map <- function() {
theme_minimal(base_size = 9) +
theme(
panel.grid       = element_blank(),
panel.background = element_rect(fill = "#EAF2F8", color = NA),
plot.background  = element_rect(fill = "white", color = NA),
axis.title       = element_blank(),
axis.text        = element_blank(),
axis.ticks       = element_blank(),
panel.border     = element_rect(color = "grey45", fill = NA,
linewidth = 0.5),
legend.position  = "bottom",
legend.box       = "horizontal",
legend.title     = element_text(size = 8),
legend.text      = element_text(size = 8),
legend.key.size  = unit(0.35, "cm"),
legend.margin    = margin(0, 8, 0, 8),
legend.box.spacing = unit(0.15, "cm"),
plot.margin      = margin(2, 2, 2, 2))
}
# =========================================================
# 15. THE MAP
# =========================================================
p <- ggplot() +
geom_sf(data = latin_america, fill = "grey95", color = "grey82",
linewidth = 0.18) +
geom_sf(data = colombia, fill = "white", color = "grey45",
linewidth = 0.35) +
# Flows, coloured by destination city
geom_sf(data = lines_top, aes(color = city),
linewidth = 0.35, alpha = 0.45, lineend = "round",
show.legend = FALSE) +
# Origin municipalities: colour = destination, size = supply level
geom_sf(data = orig_pts,
aes(color = city, size = supply_level),
shape = 16, alpha = 0.75) +
# Destination cities
geom_sf(data = dest_pts, aes(fill = city),
shape = 23, size = 3.2, stroke = 0.5, color = "grey20",
show.legend = FALSE) +
scale_color_manual(values = CITY_COLS, name = "Destination city",
guide = guide_legend(order = 1,
override.aes = list(size = 3,
linewidth = 0))) +
scale_fill_manual(values = CITY_COLS, guide = "none") +
scale_size_manual(
values = c("Low" = 1.1, "Medium" = 2.1, "High" = 3.4),
name   = "Supply volume",
labels = c(sprintf("Low (< %s t)", comma(low_max)),
sprintf("Medium (%s–%s t)", comma(low_max), comma(med_max)),
sprintf("High (> %s t)", comma(med_max))),
guide  = guide_legend(order = 2,
override.aes = list(color = "grey30"))) +
coord_sf(xlim = xlim_col, ylim = ylim_col, expand = FALSE) +
annotation_scale(location = "bl", width_hint = 0.15,
text_cex = 0.6, line_width = 0.3) +
annotation_north_arrow(location = "tr", which_north = "true",
pad_x = unit(0.1, "cm"), pad_y = unit(0.1, "cm"),
height = unit(0.6, "cm"), width = unit(0.6, "cm"),
style = north_arrow_fancy_orienteering) +
theme_map()
# Department names, added only if the column was found
if (!is.null(dept_labels)) {
p <- p + ggrepel::geom_text_repel(
data = dept_labels,
aes(x = x, y = y, label = label),
size = 2.3, color = "grey30", fontface = "italic",
segment.size = 0.2, segment.color = "grey60",
min.segment.length = 0.3, box.padding = 0.25,
max.overlaps = Inf, seed = 1)
}
# City names
city_lab <- dest_pts %>%
st_drop_geometry() %>%
bind_cols(as.data.frame(st_coordinates(dest_pts))) %>%
transmute(label = as.character(city), x = X, y = Y)
p <- p + ggrepel::geom_text_repel(
data = city_lab,
aes(x = x, y = y, label = label),
size = 2.9, fontface = "bold", color = "grey10",
segment.size = 0.25, box.padding = 0.4,
nudge_x = -0.9, seed = 2)
# =========================================================
# 16. SAVE — 174 mm is the Springer full-width figure
# =========================================================
ggsave(out_png, p, width = 17.4, height = 15.5, units = "cm",
dpi = 400, bg = "white")
ggsave(out_pdf, p, width = 17.4, height = 15.5, units = "cm", bg = "white")
cat("Saved:\n ", out_png, "\n ", out_pdf, "\n")
